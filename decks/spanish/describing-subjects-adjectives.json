    {
      "question": "Which adjective is the same for masculine and feminine singular?",
      "options": [
        "bonito",
        "grande",
        "pequeño",
        "feo"
      ],
      "answerIndex": 1,
      "explanation": "Grande ends in -e, so it doesn't change for gender (like fácil, útil and difícil). Its plural is grandes.",
